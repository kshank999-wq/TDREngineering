# ---------------------------------------------------------------------------
# TDR Engineering — Phase 1 environment variables
#
# Copy to .env.local for development. In production these live in the Vercel
# project settings. Never commit real values (spec §15: secrets stored outside
# GitHub).
# ---------------------------------------------------------------------------

# Public site URL, used for canonical URLs, sitemap and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://www.tdrengineering.com

# --- Supabase -------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SERVER ONLY. It bypasses Row Level Security and is used by
# the proposal intake route to write contacts/companies/opportunities.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket that holds proposal attachments (private bucket).
SUPABASE_PROPOSAL_BUCKET=proposal-uploads

# --- Transactional email --------------------------------------------------
# Provider for prospect confirmations and TDR notifications. This is NOT the
# employee mailbox system (spec §13: do not send bulk mail from employee
# mailboxes). Supported: "resend" | "console" (dev logging only).
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be a verified sending identity on a subdomain that does not disturb the
# deliverability of the primary @tdrengineering.com mail flow.
EMAIL_FROM="TDR Engineering <no-reply@mail.tdrengineering.com>"
EMAIL_REPLY_TO=info@tdrengineering.com
# Internal recipients for new proposal-request notifications (comma separated).
PROPOSAL_NOTIFICATION_TO=proposals@tdrengineering.com

# --- Shipping labels (Shippo) ---------------------------------------------
# Server only. A token beginning `shippo_test_` buys test labels that are not
# real postage — use one until the first end-to-end label has been verified.
SHIPPO_API_TOKEN=
# Return address printed on every label. Rates cannot be quoted without it.
SHIP_FROM_NAME="TDR Engineering"
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

# --- Bot protection (optional but recommended before launch) --------------
# Cloudflare Turnstile. When both are blank the form falls back to the
# honeypot + timing checks only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional) -------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Phase 1A archive crawler --------------------------------------------
LEGACY_SITE_URL=https://www.tdrengineering.com
ARCHIVE_OUTPUT_DIR=./archive

# --- Prospect mailing ---------------------------------------------------
# Signs the unsubscribe links in marketing email. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# SET IT ONCE AND LEAVE IT. Rotating this invalidates every unsubscribe link
# already sitting in somebody's inbox, and an opt-out link that stops working
# is the specific failure CAN-SPAM cares about.
#
# Until it is set, prospect exports omit the unsubscribe column and the admin
# says so rather than exporting a list that cannot legally be mailed.
MARKETING_UNSUBSCRIBE_SECRET=

# --- Cloud object storage for job files ---------------------------------
# S3-compatible. Cloudflare R2 recommended; Backblaze B2, Wasabi and AWS S3
# all work with the same four values. Full walkthrough: docs/CLOUD-STORAGE.md
#
# When all four are set, NEW job-file uploads go to cloud storage. Files
# already in Supabase keep working — each file records where it lives, so
# this is a gradual move, not a cutover. Leave these blank to stay on
# Supabase Storage.
#
# The secret access key is shown ONCE when you create the token. It bypasses
# every check in this application, so it goes from the provider straight into
# Vercel and is never pasted into chat, email or a document.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Google Drive for job files -----------------------------------------
# Full walkthrough, including the Google Cloud Console steps: docs/GOOGLE-DRIVE.md
#
# Created in a Google Cloud project TDR owns. The app requests the narrow
# `drive.file` scope, so it can only ever touch files it created itself —
# not the rest of the Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the Drive refresh token before it is stored in the database.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Changing it does NOT lose any files — it means clicking Connect again.
# At least 32 characters, or connected storage refuses to work at all.
STORAGE_TOKEN_KEY=
